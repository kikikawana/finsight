rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Entity Validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScenario(data) {
      return data.keys().hasAll([
          'userId', 'title', 'weeklySavings', 'initialDeposit', 'benchmarkId',
          'monthlyRent', 'targetHomePrice', 'downPaymentPercent',
          'mortgageRate', 'rentGrowthRate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'title', 'weeklySavings', 'initialDeposit', 'benchmarkId',
          'monthlyRent', 'targetHomePrice', 'downPaymentPercent',
          'mortgageRate', 'rentGrowthRate', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && (data.weeklySavings is int || data.weeklySavings is float)
        && data.weeklySavings >= 1 && data.weeklySavings <= 1000000
        && (data.initialDeposit is int || data.initialDeposit is float)
        && data.initialDeposit >= 0 && data.initialDeposit <= 100000000
        && data.benchmarkId is string && data.benchmarkId in ['sp500', 'psei', 'global60_40']
        && (data.monthlyRent is int || data.monthlyRent is float)
        && data.monthlyRent >= 0 && data.monthlyRent <= 10000000
        && (data.targetHomePrice is int || data.targetHomePrice is float)
        && data.targetHomePrice >= 100000 && data.targetHomePrice <= 500000000
        && (data.downPaymentPercent is int || data.downPaymentPercent is float)
        && data.downPaymentPercent >= 5 && data.downPaymentPercent <= 50
        && (data.mortgageRate is int || data.mortgageRate is float)
        && data.mortgageRate >= 1 && data.mortgageRate <= 25
        && (data.rentGrowthRate is int || data.rentGrowthRate is float)
        && data.rentGrowthRate >= 0 && data.rentGrowthRate <= 15
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavingsLog(data) {
      return data.keys().hasAll(['userId', 'scenarioId', 'amount', 'note', 'weekDate', 'createdAt'])
        && data.keys().hasOnly(['userId', 'scenarioId', 'amount', 'note', 'weekDate', 'createdAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidId(data.scenarioId)
        && (data.amount is int || data.amount is float)
        && data.amount >= 1 && data.amount <= 1000000
        && data.note is string && data.note.size() <= 160
        && data.weekDate is string && data.weekDate.size() == 10 && data.weekDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    function isValidMilestoneAward(data) {
      return data.keys().hasAll(['userId', 'milestoneId', 'title', 'achievedValue', 'unlockedDate', 'createdAt'])
        && data.keys().hasOnly(['userId', 'milestoneId', 'title', 'achievedValue', 'unlockedDate', 'createdAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.milestoneId is string
        && data.milestoneId in [
          'first_deposit',
          'first_1000_php',
          'first_month_consistency',
          'first_10000_php',
          'quarter_year_habit',
          'down_payment_25',
          'down_payment_50',
          'down_payment_100'
        ]
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && (data.achievedValue is int || data.achievedValue is float)
        && data.achievedValue >= 0 && data.achievedValue <= 500000000
        && data.unlockedDate is string && data.unlockedDate.size() == 10 && data.unlockedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    // Users Collection (PII strictly isolated to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
    }

    // Savings Scenarios Collection
    match /scenarios/{scenarioId} {
      allow get: if isValidId(scenarioId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(scenarioId)
        && isValidScenario(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(scenarioId)
        && existing().userId == request.auth.uid
        && isValidScenario(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'weeklySavings', 'initialDeposit', 'benchmarkId',
          'monthlyRent', 'targetHomePrice', 'downPaymentPercent',
          'mortgageRate', 'rentGrowthRate', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(scenarioId) && existing().userId == request.auth.uid;
    }

    // Weekly Savings Logs Collection
    match /savingsLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidSavingsLog(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/scenarios/$(incoming().scenarioId))
        && get(/databases/$(database)/documents/scenarios/$(incoming().scenarioId)).data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(logId) && existing().userId == request.auth.uid;
    }

    // Milestone Awards Collection
    match /milestones/{awardId} {
      allow get: if isValidId(awardId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(awardId)
        && isValidMilestoneAward(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(awardId) && existing().userId == request.auth.uid;
    }
  }
}
